# Copy to .env. Never commit credentials. With no key, use extractive demo mode.
LLM_PROVIDER=demo

# NVIDIA NIM (tested backend)
# LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Other supported backends
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Optional prices in USD per million tokens for YOUR configured model.
# Leave unset when unknown; the UI does not invent cost estimates.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=

# API: use a bearer token for shared deployments.
EREVNA_API_TOKEN=
# Only enable with the API bound to 127.0.0.1:
# EREVNA_API_LOCAL=1

# Optional semantic cache (install requirements-semantic.txt first):
# EREVNA_SEMANTIC_CACHE=1

# Operator ceiling per research run (1–10); callers can only lower it.
EREVNA_MAX_LLM_CALLS=10

# Optional UI cache path; defaults to database/memory.db in the repository.
# EREVNA_CACHE_DB=/absolute/private/path/memory.db
